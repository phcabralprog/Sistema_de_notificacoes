# Copie para .env e informe a senha definida na instalacao do PostgreSQL.
# API Node.js. No .env existente, DB_* pode ser omitido: a API reutiliza PG*.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=sistema_notificacao
PORT=3000
# O servidor escuta somente neste computador por padrao.
HOST=127.0.0.1

# Scripts Python existentes (mantidos para compatibilidade).
PGHOST=localhost
PGPORT=5432
PGDATABASE=sistema_notificacao
PGUSER=postgres
PGPASSWORD=

